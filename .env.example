# All model traffic goes through one OpenAI-compatible gateway (9router).
# api.openai.com is never called directly.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://9router-production-ff19.up.railway.app/v1
OPENROUTER_MODEL=root

# Optional fallbacks: used as gateway credential/model if the vars above are unset.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

PORT=3000
